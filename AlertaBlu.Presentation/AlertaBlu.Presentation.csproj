<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Presentation layer: the page view models and the minimal ICommand backing them, kept a
		plain net10.0 library (no MAUI reference) so AlertaBlu.Tests can exercise them directly.
		The view models talk to the MAUI head only through the framework-agnostic
		System.ComponentModel.INotifyPropertyChanged / System.Windows.Input.ICommand contracts.
		Namespace stays AlertaBlu.ViewModels even though the project is now AlertaBlu.Presentation,
		to keep XAML bindings and code-behind unchanged.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>AlertaBlu.ViewModels</RootNamespace>
		<AssemblyName>AlertaBlu.Presentation</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AlertaBlu.Application\AlertaBlu.Application.csproj" />
		<ProjectReference Include="..\AlertaBlu.Domain\AlertaBlu.Domain.csproj" />
	</ItemGroup>

</Project>
